{
  "name": "gssam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "build:sites": "node scripts/build-sites-worker.mjs",
    "build:managed": "npm run build && npm run build:sites",
    "setup": "prisma generate && node scripts/setup-db.mjs --reset && prisma db seed",
    "db:seed": "prisma db seed",
    "db:reset": "node scripts/setup-db.mjs --reset && prisma db seed",
    "verify": "node scripts/verify.mjs",
    "thumbnail": "python3 scripts/generate-youtube-thumbnail.py"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
